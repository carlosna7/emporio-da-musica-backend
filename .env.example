# Copie para .env e preencha. O .env nunca vai para o git.

# Provedor: openai | anthropic | gemini
LLM_PROVIDER=openai
# Confira o nome atual do modelo na página de preços do provedor
LLM_MODEL=gpt-6-luna
# Raciocínio do modelo OpenAI: none | low | medium | high (com raciocínio, a temperatura não é enviada)
LLM_REASONING_EFFORT=medium

# Só a chave do provedor ativo é obrigatória
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Opcional: fixa "agora" (AAAA-MM-DD, hora 10:00; ou AAAA-MM-DDTHH:MM) para testes, avaliação e exemplos
AGENT_TODAY=

# Limites
MAX_TOOL_ITERATIONS=5
HISTORY_WINDOW=20
MAX_MESSAGE_CHARS=1000
