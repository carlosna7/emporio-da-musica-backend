# Copie para .env e preencha. O .env nunca vai para o git.

# Provedor: openai | anthropic | gemini
LLM_PROVIDER=openai
# Confira o nome atual do modelo na página de preços do provedor
LLM_MODEL=gpt-5.4-mini

# Só a chave do provedor ativo é obrigatória
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Opcional: fixa a data de "hoje" (AAAA-MM-DD) para testes, avaliação e exemplos
AGENT_TODAY=

# Limites
MAX_TOOL_ITERATIONS=5
HISTORY_WINDOW=20
MAX_MESSAGE_CHARS=1000
